NODE_ENV=development
PORT=4000
DB_SERVER=
DB_NAME=farmaciadosul
DB_USER=
DB_PASSWORD=

# Seguridad / 2FA
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ¡No cambiar una vez en producción! Invalida los secretos 2FA guardados.
TOTP_ENC_KEY=
# Orígenes permitidos (separados por coma). Vacío = solo mismo origen
CORS_ORIGIN=
# true si corre detrás de un reverse proxy (IIS/nginx)
TRUST_PROXY=false
# 127.0.0.1 en producción (solo accesible vía nginx)
HOST=0.0.0.0
